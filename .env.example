
# Database
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?schema=public"

# Backend configuration
BACKEND_PORT=4000
APP_URL="http://localhost:3000"
AI_URL="http://localhost:8001"

# Security keys - replace in your actual .env only
TOKEN_ENC_KEY="your_token_encryption_key_here"
STACK_KEY="your_stack_key_here"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"

# News API
NEWS_API_KEY="your_news_api_key_here"

# Gemini AI
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
